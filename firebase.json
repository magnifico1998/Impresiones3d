{
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    },
    {
      "source": "functions-facturacion",
      "codebase": "facturacion",
      "predeploy": ["node scripts/copiar-comun-functions.mjs"],
      "ignore": ["node_modules", ".git", "firebase-debug.log"]
    }
  ]
}
