rules_version = '2';

// ⚠️ IMPORTANTE ANTES DE DESPLEGAR ESTE ARCHIVO ⚠️
// Comparalo con lo que hay hoy en Firebase Console → Firestore → Reglas
// antes de publicar, por si hay algo más que no esté reflejado acá.
//
// CAMBIO IMPORTANTE (fix de bug): el catálogo web pasó de vivir en
// colecciones raíz compartidas (catalogoConfig, catalogoProductos,
// catalogoSolicitudes) a vivir bajo catalogoTiendas/{uid}/... — porque
// cualquier cuenta de Google puede loguearse en esta app (no hay lista
// blanca), y con las reglas viejas "allow write: if request.auth != null"
// dejaba que CUALQUIER usuario autenticado publicara productos en el
// MISMO catálogo público, mezclando tiendas de distintos dueños. Ahora
// cada tienda vive en su propio uid y sólo su dueño puede escribirla.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Datos privados del dueño (biblioteca, pedidos, clientes, etc.) ----
    // OJO: a propósito NO usamos un comodín "{document=**}" acá. En
    // Firestore, si dos reglas hacen match con el mismo path, alcanza con
    // que UNA lo permita para que se otorgue el acceso (es un OR, no un
    // AND). Un comodín tan amplio taparía cualquier regla más estricta que
    // agreguemos más abajo para users/{uid}/suscripcion/** — por eso acá
    // enumeramos explícitamente sólo las colecciones que hoy existen y que
    // el dueño debe poder tocar libremente.
    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---- Usuarios adicionales por cuenta ("equipo") ----
    // Un dueño puede dar acceso total a su cuenta a otros emails de Gmail
    // (hasta el límite de su plan), sin usar custom claims: el vínculo vive
    // en invitacionesMiembro/{email}, con ID = email en minúsculas, así se
    // resuelve con un get() puntual (ver gestionarMiembros.js, que es la
    // única forma de escribir esa colección). emailDeAuth() normaliza el
    // email del token tal como lo escribe Firestore Auth (Google no
    // garantiza minúsculas).
    function emailDeAuth() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }

    function esMiembroActivo(uid) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/invitacionesMiembro/$(emailDeAuth())) &&
        get(/databases/$(database)/documents/invitacionesMiembro/$(emailDeAuth())).data.ownerUid == uid &&
        get(/databases/$(database)/documents/invitacionesMiembro/$(emailDeAuth())).data.estado == 'activo';
    }

    // Reemplaza a esDueno(uid) en las colecciones operativas de la cuenta
    // (biblioteca, pedidos, clientes, etc.): el dueño o un miembro con
    // acceso activo pueden tocarlas por igual (acceso total, sin roles).
    function tieneAcceso(uid) {
      return esDueno(uid) || esMiembroActivo(uid);
    }

    function esAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Cuenta sin suscripcion/actual todavía (dato viejo, o algo falló al
    // darla de alta) -> no bloqueamos, para no romper cuentas existentes.
    function suscripcionRef(uid) {
      return /databases/$(database)/documents/users/$(uid)/suscripcion/actual;
    }

    function cuentaPuedeEscribir(uid) {
      return !exists(suscripcionRef(uid)) ||
             get(suscripcionRef(uid)).data.estado in ['trial', 'activa'];
    }

    // 'suspendida' = pasaron los 30 días de modo lectura sin regularizar
    // (ver DURACION_LECTURA_DIAS en functions/admin.js y
    // transicionSuscripciones.js): a partir de ahí se corta también la
    // LECTURA, no sólo la escritura -- antes de esto, una cuenta suspendida
    // todavía podía seguir viendo (sólo no editar) sus datos para siempre.
    function cuentaPuedeLeer(uid) {
      return !exists(suscripcionRef(uid)) ||
             get(suscripcionRef(uid)).data.estado != 'suspendida';
    }

    // ---- Reventa de suscripciones ----
    // Un suscriptor puede ser habilitado como revendedor (ver
    // gestionarRevendedores.js): a partir de ahí su propia
    // suscripcion/actual lleva codigoRevendedor (su código propio), y las
    // cuentas que activó/renovó él llevan revendedorUid apuntando a su uid.
    // esRevendedorDe(uid) responde "¿la cuenta `uid` es una de las mías?".
    // miCodigoRevendedor() responde "¿cuál es MI código?" (o null si no soy
    // revendedor), para poder matchear leads (solicitudesContacto) que
    // todavía no tienen una suscripcion/actual vinculada.
    function esRevendedorDe(uid) {
      return request.auth != null && exists(suscripcionRef(uid)) &&
        get(suscripcionRef(uid)).data.get('revendedorUid', null) == request.auth.uid;
    }

    function miCodigoRevendedor() {
      return request.auth != null && exists(suscripcionRef(request.auth.uid))
        ? get(suscripcionRef(request.auth.uid)).data.get('codigoRevendedor', null)
        : null;
    }

    function dentroDelLimiteDePedidos(uid) {
      return !exists(suscripcionRef(uid)) ||
        get(suscripcionRef(uid)).data.cicloId == null ||
        get(suscripcionRef(uid)).data.planId == null ||
        !exists(/databases/$(database)/documents/planes/$(get(suscripcionRef(uid)).data.planId)) ||
        get(/databases/$(database)/documents/planes/$(get(suscripcionRef(uid)).data.planId)).data.get('limites', {}).get('pedidosMes', null) == null ||
        !exists(/databases/$(database)/documents/users/$(uid)/suscripcion/actual/contadores/$(get(suscripcionRef(uid)).data.cicloId)) ||
        get(/databases/$(database)/documents/users/$(uid)/suscripcion/actual/contadores/$(get(suscripcionRef(uid)).data.cicloId)).data.get('pedidosCreados', 0) <
          get(/databases/$(database)/documents/planes/$(get(suscripcionRef(uid)).data.planId)).data.get('limites', {}).get('pedidosMes', null);
    }

    // (El documento raíz users/{uid} ya no existe ni se lee: la migración
    // legacy Fase 1-5 se retiró de AppContext.jsx cuando no quedó ninguna
    // cuenta sin migrar. Cada doc users/{uid} es hoy un "fantasma" que sólo
    // agrupa subcolecciones, y esas tienen sus propias reglas acá abajo.)

    match /users/{uid}/meta/{document=**} {
      allow read: if tieneAcceso(uid) && cuentaPuedeLeer(uid);
      // "create" separado de "update/delete" a propósito: la primera carga
      // de CUALQUIER cuenta necesita poder crear este doc con valores
      // default si todavía no existe (ver cargarConfigDeFirestore en
      // AppContext.jsx) -- si esa creación quedara atada a
      // cuentaPuedeEscribir, una cuenta que nunca llegó a cargar la app ni
      // una vez (ej: quedó de miembro de otra cuenta todo este tiempo) y
      // pasa a lectura/suspendida sin ese doc creado, queda trabada en un
      // loop de error para siempre: ni puede leer (no hay nada creado) ni
      // puede escribir para crearlo. Crear con valores default no filtra
      // ni pisa nada real, así que dejarlo pasar siempre es seguro.
      allow create: if tieneAcceso(uid);
      allow update, delete: if tieneAcceso(uid) && cuentaPuedeEscribir(uid);
    }
    match /users/{uid}/clientes/{docId} {
      allow read: if tieneAcceso(uid) && cuentaPuedeLeer(uid);
      allow write: if tieneAcceso(uid) && cuentaPuedeEscribir(uid);
    }
    match /users/{uid}/compras/{docId} {
      allow read: if tieneAcceso(uid) && cuentaPuedeLeer(uid);
      allow write: if tieneAcceso(uid) && cuentaPuedeEscribir(uid);
    }
    match /users/{uid}/biblioteca/{docId} {
      allow read: if tieneAcceso(uid) && cuentaPuedeLeer(uid);
      allow write: if tieneAcceso(uid) && cuentaPuedeEscribir(uid);
    }
    match /users/{uid}/pedidos/{docId} {
      allow read: if tieneAcceso(uid) && cuentaPuedeLeer(uid);
      // Los pedidos no se borran, sólo se cancelan (estado 'cancelado'):
      // no se permite delete, ni siquiera para el dueño de la cuenta.
      allow update: if tieneAcceso(uid) && cuentaPuedeEscribir(uid);

      // Crear un pedido nuevo exige además que la cuenta no esté en modo
      // lectura/suspendida, y que no haya superado el límite de pedidos
      // del plan contratado para el ciclo de facturación vigente. Si algo
      // de esto no existe todavía (cuenta vieja sin suscripcion/actual, o
      // plan sin límite configurado), dejamos pasar para no romper cuentas
      // existentes — el enforcement real entra en vigencia a medida que
      // se van dando de alta las suscripciones.
      allow create: if tieneAcceso(uid) && cuentaPuedeEscribir(uid) && dentroDelLimiteDePedidos(uid);
    }

    // ---- Suscripción de cada cuenta ----
    // Cada usuario lee SU propia suscripción (para mostrar el cartel de
    // trial/vencimiento), y cualquier admin puede leer la de cualquiera
    // (para el panel). Las escrituras están cerradas del todo: todo cambio
    // de estado pasa por una Cloud Function con Admin SDK (ver
    // functions/index.js), así queda todo loggeado en "eventos" y no hay
    // riesgo de que alguien —dueño o admin comprometido— se autoactive la
    // cuenta editando Firestore directo.
    match /users/{uid}/suscripcion/{docId} {
      allow read: if tieneAcceso(uid) || esAdmin() || esRevendedorDe(uid);
      allow write: if false;

      match /eventos/{eventoId} {
        allow read: if tieneAcceso(uid) || esAdmin() || esRevendedorDe(uid);
        allow write: if false;
      }
      match /contadores/{cicloId} {
        allow read: if tieneAcceso(uid) || esAdmin() || esRevendedorDe(uid);
        allow write: if false;
      }
    }

    // Regla ADICIONAL (Firestore combina reglas que matchean el mismo path
    // con OR), sólo para destrabar el listado con collectionGroup('suscripcion')
    // que usa el panel admin para traer TODAS las cuentas de golpe -- una
    // regla de ruta fija como la de arriba no alcanza a cubrir ese tipo de
    // consulta transversal, Firestore exige el patrón recursivo {path=**}
    // para eso. A propósito NO repetimos acá la lógica de "es el dueño"
    // extrayendo el uid del wildcard (evitamos indexar un `path`, que sin
    // poder probarlo contra el emulador real es fuente fácil de bugs) --
    // el dueño ya tiene su acceso cubierto por la regla de arriba vía
    // getDoc/onSnapshot normal, así que esta sólo necesita cubrir admins y
    // revendedores (acá sí podemos usar resource.data directo porque el
    // propio doc que matchea YA es el suscripcion/actual que se está
    // leyendo, sin necesidad de un get() extra).
    match /{pathPrefix=**}/suscripcion/{docId} {
      allow read: if esAdmin() ||
        (docId == 'actual' && resource.data.get('revendedorUid', null) == request.auth.uid);
    }

    // ---- Catálogo de planes (configurable desde el panel admin) ----
    // Lectura pública: la necesitamos tanto en la app (para comparar
    // límites del plan actual) como eventualmente en una pantalla pública
    // de precios. Sólo un admin puede crear/editar/borrar planes.
    match /planes/{planId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ---- Preguntas frecuentes (contenido global, no por-cuenta) ----
    // Visible para cualquier usuario con sesión iniciada (dueño o miembro
    // invitado de cualquier cuenta) -- a diferencia de "planes" no es
    // pública del todo, por eso exige request.auth != null en vez de
    // "true". Sólo un admin general puede crear/editar/borrar preguntas.
    match /faq/{faqId} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    // Orden manual de las categorías de FAQ (arrastrar para reordenar en el
    // panel admin, mismo concepto que cfg.categoriaOrden de Biblioteca pero
    // guardado acá porque es global, no por cuenta).
    match /faqMeta/{docId} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    // ---- Solicitudes de contacto ("contactate con el área comercial") ----
    // Un doc por cuenta (ID = uid), así crear y editar son la misma
    // operación. Sólo el dueño arma/edita la suya (los datos que el
    // interesado carga en el formulario), con los campos mínimos validados
    // acá. Un admin sólo puede tocar el campo "estado" (para marcarla como
    // "contactado") -- para corregir datos personales/impositivos de un
    // suscriptor ya existe "datosSuscriptor" más abajo, una colección
    // aparte a propósito: antes esas correcciones se guardaban acá mismo y,
    // como esta colección tiene su propio flujo de "pendiente/contactado"
    // para leads entrantes, cada corrección resucitaba la cuenta como si
    // fuera una solicitud de contacto nueva.
    match /solicitudesContacto/{uid} {
      // Además del dueño/admin, un revendedor puede ver sus propios leads:
      // los que ya tiene vinculados (esRevendedorDe) y los que todavía no
      // se activaron pero ya traen SU código cargado en el formulario de
      // contacto (para poder activarlos él mismo sin pasar por el admin).
      allow read: if tieneAcceso(uid) || esAdmin() || esRevendedorDe(uid) ||
        (miCodigoRevendedor() != null && resource.data.get('codigoRevendedor', null) == miCodigoRevendedor());

      allow create: if tieneAcceso(uid) &&
        request.resource.data.keys().hasAll(['nombre','apellido','localidad','telefono','email','resena']) &&
        request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 && request.resource.data.nombre.size() < 100 &&
        request.resource.data.apellido is string && request.resource.data.apellido.size() > 0 && request.resource.data.apellido.size() < 100 &&
        request.resource.data.localidad is string && request.resource.data.localidad.size() > 0 && request.resource.data.localidad.size() < 100 &&
        request.resource.data.telefono is string && request.resource.data.telefono.matches('^[0-9]{10}$') &&
        request.resource.data.email is string && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        request.resource.data.resena is string && request.resource.data.resena.size() < 600 &&
        (!('codigoRevendedor' in request.resource.data) ||
          request.resource.data.codigoRevendedor == null ||
          (request.resource.data.codigoRevendedor is string && request.resource.data.codigoRevendedor.matches('^[A-Z0-9]{4,12}$')));

      allow update: if
        (tieneAcceso(uid) &&
          request.resource.data.keys().hasAll(['nombre','apellido','localidad','telefono','email','resena']) &&
          request.resource.data.telefono.matches('^[0-9]{10}$') &&
          request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
          (!('codigoRevendedor' in request.resource.data) ||
            request.resource.data.codigoRevendedor == null ||
            (request.resource.data.codigoRevendedor is string && request.resource.data.codigoRevendedor.matches('^[A-Z0-9]{4,12}$')))) ||
        // El admin sólo puede tocar "estado" (marcar contactado) o
        // "codigoRevendedor" (completarlo a mano si el cliente no lo hizo)
        // -- nunca los datos de contacto, eso vive en datosSuscriptor.
        (esAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'codigoRevendedor']) &&
          (!('codigoRevendedor' in request.resource.data) ||
            request.resource.data.codigoRevendedor == null ||
            (request.resource.data.codigoRevendedor is string && request.resource.data.codigoRevendedor.matches('^[A-Z0-9]{4,12}$'))));

      allow delete: if false;
    }

    // ---- Datos personales/impositivos de un suscriptor (uso interno admin) ----
    // Un doc por cuenta (ID = uid), completamente separado de
    // solicitudesContacto -- ver el comentario de arriba. Sólo lo gestiona
    // un admin desde "Consultar datos" en el panel de Suscriptores; el
    // dueño de la cuenta no tiene hoy ninguna pantalla que lo muestre, pero
    // puede leer el suyo por si el día de mañana se expone.
    match /datosSuscriptor/{uid} {
      allow read: if tieneAcceso(uid) || esAdmin() || esRevendedorDe(uid);
      allow write: if esAdmin() || esRevendedorDe(uid);
    }

    // ---- Revendedores ----
    // Doc ID = código (ej "JUAN20"). Mapeo inverso código -> uid, para que
    // el admin (o la Cloud Function cambiarEstadoSuscripcion) pueda
    // resolver un código cargado en una solicitud sin conocer de antemano
    // a quién pertenece. Sólo lo escriben Cloud Functions (ver
    // gestionarRevendedores.js) -- nunca el cliente directo, ni siquiera
    // un admin, para que el alta/baja quede siempre auditada.
    match /revendedores/{codigo} {
      allow read: if esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow write: if false;

      // Ventas atribuidas a este revendedor, agrupadas por mes (YYYY-MM):
      // ledger incremental que arma cambiarEstadoSuscripcion en cada
      // activación/renovación atribuida, para poder cerrar el mes con una
      // sola lectura (sin collectionGroup ni índice compuesto sobre
      // eventos). Sólo lo ve el admin principal -- es información de
      // facturación, no algo que el propio revendedor necesite auditar.
      match /ventas/{anioMes} {
        allow read: if esAdmin();
        allow write: if false;
      }
    }

    // ---- Catálogo web público, uno por tienda (uid del dueño) ----
    // Lo navega gente SIN login desde /catalogo/{uid}. Sólo exponemos acá
    // lo que cada dueño decidió publicar explícitamente (ver
    // publicarProductosEnCatalogo en AppContext.jsx) — nunca su biblioteca
    // ni sus pedidos reales. La parte importante del fix: todas las
    // escrituras exigen que sea el MISMO uid autenticado el que está
    // tocando SU propia carpeta de catálogo — no cualquier usuario logueado.
    match /catalogoTiendas/{uid} {

      // Config visible del catálogo de esta tienda (nombre, colores, si
      // está activo). Cualquiera la puede leer; sólo su dueño (o un
      // miembro con acceso) la escribe.
      allow read: if true;
      allow write: if tieneAcceso(uid);

      // Productos publicados de ESTA tienda (mirror sanitizado de su
      // biblioteca: nombre, cat, desc, imagen, precio — nunca costos
      // internos). Lectura pública, escritura sólo del dueño o un miembro.
      match /productos/{prodId} {
        allow read: if true;
        allow write: if tieneAcceso(uid);
      }

      // Solicitudes que arma un cliente en ESTE catálogo. Cualquiera
      // puede CREAR una (con forma validada y estado inicial fijo en
      // "pendiente"), pero NADIE sin login puede leer, editar ni borrar
      // solicitudes ajenas — así un cliente no puede ver el pedido de
      // otro. Sólo el dueño de esta tienda gestiona esta colección desde
      // el panel "Catálogo web" de la app.
      match /solicitudes/{docId} {
        allow create: if request.resource.data.keys().hasAll(['cliente', 'items', 'estado', 'creado'])
                      && request.resource.data.estado == 'pendiente'
                      && request.resource.data.cliente is string
                      && request.resource.data.cliente.size() > 0
                      && request.resource.data.cliente.size() < 200
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0
                      && request.resource.data.items.size() < 50;
        allow read, update, delete: if tieneAcceso(uid);
      }
    }

    // ---- Usuarios adicionales por cuenta ("equipo") ----
    // El ID de cada doc es el email en minúsculas del colaborador. Lo puede
    // leer el dueño de la cuenta a la que pertenece (resource.data.ownerUid)
    // -- así el listado que arma "Mi emprendimiento" con
    // where('ownerUid','==',cuentaId) funciona, Firestore evalúa esta regla
    // por cada doc que devuelve la query -- o la propia persona invitada
    // (para saber si tiene un vínculo activo al loguearse). Las escrituras
    // están cerradas del todo: sólo agregarMiembro/quitarMiembro (Cloud
    // Functions con Admin SDK) pueden crear o borrar un vínculo, así el
    // límite de usuarios del plan se valida siempre server-side y nadie
    // puede auto-otorgarse acceso a una cuenta ajena editando Firestore.
    match /invitacionesMiembro/{emailId} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid || emailDeAuth() == emailId);
      allow write: if false;
    }

    // ---- Panel de administración (whitelist de emails admin) ----
    // El ID de cada doc es el email en minúsculas (ej: admins/pepe@gmail.com).
    // Cualquier usuario logueado puede chequear SI ÉL MISMO es admin (lectura
    // de su propio doc), y quien ya es admin puede ver el listado completo
    // para gestionarlo desde el panel. Las escrituras están cerradas desde
    // el cliente a propósito: agregar/quitar admins se hace a mano desde
    // Firebase Console (o más adelante con una Cloud Function con Admin SDK,
    // que igual ignora estas reglas) — así ningún usuario, ni siquiera un
    // admin comprometido vía XSS, puede escalar privilegios escribiendo acá.
    match /admins/{email} {
      allow read: if request.auth != null &&
                    (request.auth.token.email.lower() == email || esAdmin());
      allow write: if false;
    }
  }
}
