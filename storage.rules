rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // El dueño de la carpeta, o cualquier email vinculado como miembro activo
    // de esa cuenta (ver firestore.rules / invitacionesMiembro y
    // functions/http/gestionarMiembros.js). Los uploads de un miembro (logo,
    // imágenes de producto) quedan en la MISMA carpeta users/{uid del
    // dueño}/... porque el cliente arma la ruta con cuentaId (ver
    // AppContext.jsx), nunca con su propio uid.
    function esDeLaCuenta(userId) {
      return request.auth != null && (
        request.auth.uid == userId ||
        (
          request.auth.token.email_verified == true &&
          firestore.exists(/databases/(default)/documents/invitacionesMiembro/$(request.auth.token.email.lower())) &&
          firestore.get(/databases/(default)/documents/invitacionesMiembro/$(request.auth.token.email.lower())).data.ownerUid == userId &&
          firestore.get(/databases/(default)/documents/invitacionesMiembro/$(request.auth.token.email.lower())).data.estado == 'activo'
        )
      );
    }

    // Acceso total, sin roles, salvo los archivos G-code (abajo). La subcarpeta
    // (biblioteca, catálogo, logo…) es una variable para poder excluir las del
    // G-code: en estas reglas allPaths es una ruta, no un texto, y no admite
    // .matches() (con eso se rechazaban TODAS las imágenes, ver TKT-0004).
    match /users/{userId}/{carpeta}/{allPaths=**} {
      allow read, write: if esDeLaCuenta(userId) && carpeta != 'gcode' && carpeta != 'gcode-entrada';
    }
    // Archivos sueltos directamente en users/{uid}/, sin subcarpeta.
    match /users/{userId}/{archivo} {
      allow read, write: if esDeLaCuenta(userId);
    }

    // Archivos G-code de la Biblioteca (functions/triggers/onGcodeSubido.js):
    // la cuenta sólo sube a la entrada (hasta 300 MB por archivo); la función
    // lo comprime, controla el cupo del plan y lo guarda en gcode/. Desde ahí
    // la cuenta lo baja o lo borra, pero no escribe directo.
    match /users/{userId}/gcode-entrada/{archivoId} {
      allow create: if esDeLaCuenta(userId) && request.resource.size <= 300 * 1024 * 1024;
    }
    // Programa del conector de impresión (conector/empaquetar.mjs, se sube con
    // scripts/subir-conector.mjs): lo baja cualquier usuario logueado desde
    // Configuración → Impresión directa; nadie lo escribe desde la app.
    match /conector/{archivo} {
      allow read: if request.auth != null;
    }
    match /users/{userId}/gcode/{archivo} {
      allow read, delete: if esDeLaCuenta(userId);
      // El conector de impresión de la cuenta (functions/http/conectores.js) sólo los baja.
      allow read: if request.auth != null && request.auth.token.get('conectorDe', null) == userId;
    }
  }
}
